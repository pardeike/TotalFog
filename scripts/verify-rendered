    absolute = (bounds[0] + box[0], bounds[1] + box[1], bounds[2] + box[0], bounds[3] + box[1])
    rect = report["rootClip"]
    require(
        absolute[0] >= rect["XMin"]
        and absolute[1] >= h - rect["YMax"]
        and absolute[2] <= rect["XMax"]
        and absolute[3] <= h - rect["YMin"],
        "Lighting refresh changed unseen cells",
    )
elif kind == "gameplay":
    require(
        all(
            report[key]
            for key in (
                "simulationStayedPaused",
                "hiddenOwnersUnchanged",
                "onlyRevisitedCellChangedOwner",
                "treeDestroyed",
                "idleCapturesUnchanged",
                "idleCommandsUnchanged",
            )
        )
        and report["idleFrames"] == 100
        and report["observationCells"] == 81
        and report["CaptureCount"] > 0
        and report["OwnerCount"] > 0
        and report["DrawCount"] > 0,
        "Installed gameplay ownership failed",
    )
    compare("hidden", "hidden-native")
    compare("hidden", "hidden-changed")
    compare("hidden", "hidden-destroyed")
    compare("visible", "hidden", equal=False)
    change = compare("hidden-destroyed", "root-revisited", equal=False)
    bounds = change["bounds"]
    absolute = (bounds[0] + box[0], bounds[1] + box[1], bounds[2] + box[0], bounds[3] + box[1])
    rect = report["rootClip"]
    require(
        absolute[0] >= rect["XMin"]
        and absolute[1] >= h - rect["YMax"]
        and absolute[2] <= rect["XMax"]
        and absolute[3] <= h - rect["YMin"],
        "Gameplay refresh changed unseen cells",
    )
else:
    require(
        prepared["treeDestroyed"]
        and prepared["simulationStayedPaused"]
        and prepared["retainedCells"] == 81
        and report["destroyedOakAbsent"]
        and report["onlyRevisitedCellChangedOwner"]
        and report["simulationStayedPaused"]
        and report["retainedCells"] == 81
        and report["RestoredOwnerCount"] == prepared["RecordCount"]
        and report["RestoredCellCount"] >= 81,
        "Saved gameplay ownership failed",
    )
    if "terrainMemory" in prepared:
        terrain = prepared["terrainMemory"]
        expected_layers = {"ThingsGeneral", "Terrain"}
        if "lightingMemory" in prepared:
            expected_layers.add("Lighting")
            light = prepared["lightingMemory"]
            restored_light = report["lightingMemory"]
            require(
                light["torchDestroyed"]
                and light["retainedLightingCells"] == 81
                and light["nativeChangedLightingVertices"] > 0
                and light["hiddenLightingOwnersUnchanged"]
                and restored_light["torchAbsent"]
                and restored_light["roofsAbsent"]
                and restored_light["retainedLightingCells"] == 81
                and restored_light["onlyRevisitedLightingCellChangedOwner"],
                "Lighting observation or save ownership failed",
            )
            require(
                report["RestoredCellCount"] == sum(item["cells"] for item in prepared["layers"]),
                "The game did not restore every saved cell assignment",
            )
        if "maskMemory" in prepared:
            expected_layers.add("IndoorMask")
            mask = prepared["maskMemory"]
            restored_mask = report["maskMemory"]
            require(
                mask["retainedMaskCells"] == 81
                and mask["hiddenMaskOwnersUnchanged"]
                and restored_mask["retainedMaskCells"] == 81
                and restored_mask["onlyRevisitedMaskCellChangedOwner"],
                "Roof mask observation or save ownership failed",
            )
            pose = prepared["poses"][0]
            require(
                all(
                    item[key] == pose[key]
                    for item in prepared["poses"]
                    for key in ("projection", "view", "sky")
                ),
                "Save preparation camera or sky changed",
            )
        require(
            terrain["originalTerrain"] != terrain["changedTerrain"]
            and terrain["initialKnownTerrainCells"] == 81
            and terrain["unknownTerrainCellRemainsUnknown"]
            and terrain["hiddenTerrainOwnersUnchanged"]
            and report["terrainMemory"]["changedTerrainPresent"]
            and report["terrainMemory"]["retainedTerrainCells"] == 81
            and report["terrainMemory"]["onlyRevisitedTerrainCellChangedOwner"]
            and {item["layer"] for item in prepared["layers"] if item["owners"] > 0}
            == expected_layers,
            "Terrain observation or save ownership failed",
        )
        compare("visible", "visible-native")
        compare("hidden-before-changes", "before-save")
        compare("before-save", "before-save-background", equal=False)
    comparison_preparation = prepared
    if (root / "section-save-reference-live.json").exists():
        import xml.etree.ElementTree as ET

        reference = json.loads((root / "section-save-reference-live.json").read_text())["result"][
            "structuredContent"
        ]
        require(
            reference["operation"]["Success"]
            and not reference["operation"]["Warnings"]
            and reference["referenceAfterSave"]
            and not report["referenceAfterSave"]
            and reference["simulationStayedPaused"],
            "The native load-tick reference did not complete",
        )
        reference_log = (root / "section-save-reference-player.log").read_text(errors="replace")
        require(
            not any(
                word in line.lower()
                for line in reference_log.splitlines()
                for word in ("error", "exception", "warning")
            ),
            "Load-tick reference has runtime diagnostics",
        )
        saved_tick = int(
            ET.parse(saved_file(saved["path"])).getroot().find("./game/tickManager/ticksGame").text
        )
        environment = reference["isolatedPicture"]["environment"]
        require(
            reference["savedTick"] == saved_tick
            and environment["ticksGame"] == saved_tick + 1
            and environment["PauseOnLoad"]
            and environment == report["isolatedPicture"]["environment"],
            "Save comparison uses different simulation time or native rendering inputs",
        )
        require(
            reference["clip"] == report["clip"]
            and reference["pixelHeight"] == report["pixelHeight"],
            "Load-tick reference camera differs",
        )
        if reference.get("windControl", {}).get("enabled") or report.get("windControl", {}).get(
            "enabled"
        ):
            for attempt in (reference, report):
                control = attempt.get("windControl", {})
                require(
                    control.get("enabled")
                    and control.get("materials", 0) > 0
                    and control.get("allNativeValuesZero")
                    and control.get("restoredOriginalValues"),
                    "Native wind comparison lacks a verified control or restoration",
                )
            metrics["nativeWindControl"] = {
                "referenceMaterials": reference["windControl"]["materials"],
                "loadedMaterials": report["windControl"]["materials"],
                "restoredOriginalValues": True,
            }
        require(
            reference["savedResources"]["textures"] == report["savedResources"]["textures"],
            "Restored GPU texture bytes or sampler metadata differ from the reference",
        )
        if (
            "currentlyVisible" in reference["savedResources"]
            or "currentlyVisible" in report["savedResources"]
        ):
            from observed_archive import compare_hidden_observations

            metrics["hiddenArchive"] = compare_hidden_observations(
                saved_file(reference["savedResources"]["path"]),
                reference["savedResources"],
                saved_file(report["savedResources"]["path"]),
                report["savedResources"],
            )
        reference_records = {item["phase"]: item for item in reference["evidence"]}
        for before, after in (
            ("before-save", "after-load"),
            ("before-save-background", "after-load-background"),
            ("before-save-picture", "after-load-picture"),
            ("before-save-empty", "after-load-empty"),
        ):
            records[before] = reference_records[after]
        comparison_preparation = reference
        metrics["nativeLoadTick"] = {"savedTick": saved_tick, "comparisonTick": saved_tick + 1}
    if kind == "save-picture":
        scope = json.loads((root / "section-save-picture-proof.json").read_text())
        require(
            scope
            == {"scope": "installed remembered drawings with ordinary map and weather excluded"},
            "Unknown saved-picture comparison scope",
        )
        if "projection" in comparison_preparation["isolatedPicture"]:
            for key in ("projection", "view"):
                require(
                    comparison_preparation["isolatedPicture"][key]
                    == report["isolatedPicture"][key]
                    == report["isolatedRevisitedPicture"][key],
                    "Saved-picture camera changed: " + key,
                )
        for proof in (
            comparison_preparation["isolatedPicture"],
            report["isolatedPicture"],
            report["isolatedRevisitedPicture"],
        ):
            require(
                proof["attachedCommands"] > 0
                and proof["rememberedDraws"] > 0
                and proof["excludedMapDraws"] > 0
                and proof["excludedWeatherDraws"] > 0,
                "Saved-picture isolation did not execute",
            )
            if proof["includesEmptyControl"]:
                require(
                    0 <= proof["detachedCommands"] < proof["attachedCommands"],
                    "Empty control did not detach memory",
                )
        require(
            prepared["isolatedPicture"]["includesEmptyControl"]
            and report["isolatedPicture"]["includesEmptyControl"],
            "Missing saved-picture positive controls",
        )
        compare("before-save-empty", "after-load-empty")
        compare("before-save-picture", "after-load-picture")
        compare("before-save-empty", "before-save-picture", equal=False)
        compare("after-load-empty", "after-load-picture", equal=False)
        change = compare("after-load-picture", "after-load-picture-revisited", equal=False)
    else:
        compare("before-save-background", "after-load-background")
        compare("before-save", "after-load")
        change = compare("after-load", "after-load-revisited", equal=False)
    bounds = change["bounds"]
    absolute = (bounds[0] + box[0], bounds[1] + box[1], bounds[2] + box[0], bounds[3] + box[1])
    rect = report["rootClip"]
    require(
        absolute[0] >= rect["XMin"]
        and absolute[1] >= h - rect["YMax"]
        and absolute[2] <= rect["XMax"]
        and absolute[3] <= h - rect["YMin"],
        "Loaded refresh changed unseen cells",
    )

(root / "verification.json").write_text(json.dumps(metrics, indent=2) + "\n")
